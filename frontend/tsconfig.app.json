{
  "compilerOptions": {
    /* Target modern JS for better performance */
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    /* React + JSX settings */
    "jsx": "react-jsx",

    /* Module + resolution setup for Vite */
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* ShadCN / alias setup */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Type checking + linting */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Experimental modern TS flags */
    "useDefineForClassFields": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}